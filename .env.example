# Copy to .env and fill in. Never commit .env.

# GigaChat authorization key (chat with the advisor)
API_KEY=

# Signs access/refresh tokens. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Admin account for /admin, created or updated on startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Shown in the privacy policy at /privacy
PRIVACY_OPERATOR=
PRIVACY_CONTACT=

# Only for the optional Telegram bot (docker compose --profile bot up)
BOT_TOKEN=

# Host port for the web app
PORT=8000
